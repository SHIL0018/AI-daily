{
  "name": "activity-daily-desktop-client",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop client for local screen activity summaries and sync.",
  "main": "dist/main/main/app.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run",
    "test:main": "vitest run --config vitest.main.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "npm run build:main && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "start:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-client.ps1",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "active-win": "9.0.0",
    "better-sqlite3": "12.11.1",
    "electron-log": "5.4.4",
    "lucide-react": "0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "cross-env": "10.1.0",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3",
    "vite": "8.1.1",
    "vitest": "3.2.7"
  },
  "build": {
    "appId": "com.activitydaily.client",
    "productName": "Activity Daily Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "artifactName": "${productName} Setup ${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Activity Daily Client",
      "include": "build/installer.nsh",
      "runAfterFinish": false
    },
    "extraFiles": [
      {
        "from": "launchers/start-client-installed.cmd",
        "to": "start-client.cmd"
      },
      {
        "from": "launchers/start-client-installed.ps1",
        "to": "start-client.ps1"
      }
    ]
  }
}
